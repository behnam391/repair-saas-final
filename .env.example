# Postgres connection string. Easiest free options: Neon (neon.tech) or Supabase.
DATABASE_URL="postgresql://user:password@host:5432/repairsaas"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
# In dev use localhost. In PRODUCTION on Vercel set this to your live domain
# (e.g. https://peyvo.ir) — it must match the domain the app is served from,
# or sign-in redirects and the payment callbacks will break.
NEXTAUTH_URL="http://localhost:3000"

# Canonical customer-facing domain. Payment callbacks, QR codes and links sent
# by SMS must use this host (not a Vercel preview/production URL).
PUBLIC_APP_URL="https://peyvo.ir"
NEXT_PUBLIC_APP_URL="https://peyvo.ir"

# Kavenegar SMS (https://panel.kavenegar.com) — leave empty in dev to skip real sends
KAVENEGAR_API_KEY=""
KAVENEGAR_SENDER="10004346"

# Payment gateway — the active provider is chosen in /superadmin/settings.
# These env vars are fallbacks if the platform-settings row is empty.
# Zarinpal (empty = automatic sandbox, no real money — good for testing the flow)
ZARINPAL_MERCHANT_ID=""
# Zibal (https://zibal.ir) — "zibal" is their test merchant
ZIBAL_MERCHANT=""
# NextPay (https://nextpay.org)
NEXTPAY_API_KEY=""
# Which gateway is live: zarinpal | zibal | nextpay
PAYMENT_PROVIDER="zarinpal"

# Myket in-app billing. These are server fallbacks when the Super Admin panel
# has no value. The access token must NEVER be bundled into the Android app.
MYKET_PACKAGE_NAME="com.peyvo.app"
MYKET_RSA_PUBLIC_KEY=""
MYKET_ACCESS_TOKEN=""

# Android release signing (local/CI only; never commit real passwords)
# PEYVO_KEYSTORE_PATH="C:/secure/Peyvo"
# PEYVO_KEYSTORE_PASSWORD=""
# PEYVO_KEY_ALIAS=""
# PEYVO_KEY_PASSWORD=""

# Any random string — protects the daily subscription-reminder cron job.
# Generate with: openssl rand -base64 32
CRON_SECRET="change-me"

# Vercel Blob storage token — needed for REAL image uploads (avatars, ad
# banners) in production. Create it in Vercel → your project → Storage →
# Blob → "Create store"; the token is added automatically on deploy, or
# copy it here for local testing. Leave empty in dev: files then land in
# ./public/uploads instead (works locally, but NOT on Vercel).
BLOB_READ_WRITE_TOKEN=""

# ── AI foundation (Phase 2 — provider-agnostic; no real provider wired yet) ──
# All server-side. Default is OFF. Providers: disabled | mock | openai-compat.
# "mock" is an offline deterministic provider for dev/tests. "openai-compat"
# talks to ANY OpenAI-compatible /chat/completions endpoint via AI_BASE_URL
# (OpenAI, a proxy, or a self-hosted Ollama/vLLM) — set only when you have one.
AI_ENABLED="false"
AI_PROVIDER="disabled"
# AI_FALLBACK_PROVIDER="mock"      # optional: tried if the primary fails
AI_MODEL="mock-model"
# AI_BASE_URL=""                   # required for openai-compat
# AI_API_KEY=""                    # server-side only; never sent to the client
AI_TIMEOUT_MS="20000"
AI_MAX_RETRIES="2"
AI_MAX_TOKENS="1024"
AI_TEMPERATURE="0.2"
AI_SHOP_DAILY_LIMIT="200"          # per-shop daily call cap (0 = unlimited)
