.DS_Store
*.log
npm-debug.log*

# Android build output is ignored, except for the signed APK deliberately
# published from public/downloads.
/android/app/build/
/public/downloads/peyvo-android-v1.2.apk

# typescript
*.tsbuildinfo
next-env.d.ts
