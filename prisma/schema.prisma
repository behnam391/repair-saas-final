// ─────────────────────────────────────────────────────────────
// Repair Shop SaaS — Database Schema
// Multi-tenant model: every business table carries shopId so one
// Postgres database safely serves many shops (row-level isolation
// enforced in lib/tenant.ts on every query, not just here).
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Tenant ──────────────────────────────────────────────────

model Shop {
  id            String   @id @default(cuid())
  name          String
  phone         String?
  address       String?
  province      String? // structured province name (from lib/iran-locations.ts) — used for city/province rankings
  // "REPAIR" (repair shop, default) | "DEALER" (phone buy/sell dealer) | "BOTH"
  type          String   @default("REPAIR")
  // business size chosen at signup: "SOLO" (one person doing everything),
  // "TEAM" (owner + a few staff with chosen specialties), "ENTERPRISE" (many staff)
  businessSize  String   @default("SOLO")
  specialties   String?  // comma-separated: e.g. "HARDWARE,SOFTWARE" — which repair types this shop offers
  landlinePhone String?  // shop's fixed/landline number, separate from the mobile `phone` above
  latitude      Float?
  longitude     Float?
  // identity verification level: 1 = just signed up, 2 = full profile submitted,
  // 3 = reviewed and approved by platform admin
  verificationLevel   Int     @default(1)
  verificationRequestedAt DateTime?
  // subscription plan: "free" | "pro" | "business"
  plan          String   @default("free")
  planExpiresAt DateTime?
  active        Boolean  @default(true) // super admin can suspend a shop
  isTest        Boolean  @default(false) // super admin can mark a shop as test/demo, for later bulk cleanup
  supportAccessEnabled Boolean @default(false) // shop owner (or super admin, for urgent support cases) can allow platform staff temporary visibility into this shop's admin panel
  // monthly device-intake quota enforced for the "free" plan
  monthlyQuota  Int      @default(10)
  smsSenderName String? // shown as the sender name in outgoing SMS
  bankCardNumber    String? // shown on invoice/SMS if the shop opts in
  bankAccountNumber String?
  taxPercent    Float    @default(10) // applied to invoice totals; shop can adjust
  // Prepaid wallet balance (toman). The shop tops this up via the payment
  // gateway (arbitrary amount) and can then pay subscriptions from it without
  // going back to the gateway each time. Every change is journaled in
  // WalletTransaction; this column is the fast-read current total.
  walletBalance Int      @default(0)
  createdAt     DateTime @default(now())

  users         User[]
  customers     Customer[]
  tickets       Ticket[]
  inventory     InventoryItem[]
  invoices      Invoice[]
  marketListings MarketListing[]
  marketReplies  MarketReply[]
  subscriptions  Subscription[]
  deviceFlags        DeviceFlag[]
  deviceTransactions DeviceTransaction[]
  favoriteBrands     FavoriteBrand[]
  customDeviceModels CustomDeviceModel[]
  issueTemplates     IssueTemplate[]
  supportTickets     SupportTicket[]
  returns            ReturnRecord[]
  pendingIntakes     PendingIntake[]
  dealerInventory    DealerInventory[]
  ratings            Rating[]
  partRequests       PartRequest[]
  referencePrices    ReferencePrice[]
  partnershipsSent     ShopPartnership[] @relation("PartnershipSentBy")
  partnershipsReceived ShopPartnership[] @relation("PartnershipSentTo")
  referralsSent        ShopReferral[]    @relation("ReferralFrom")
  referralsReceived    ShopReferral[]    @relation("ReferralTo")
  expenses           Expense[]
  walletTransactions WalletTransaction[]
  partnerContacts    PartnerContact[]
}

model PartnerContact {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  address   String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId, name])
  @@index([shopId, phone])
}

// ── Shop wallet ledger (کیف پول) ──────────────────────────────
// One row per money movement on a shop's prepaid wallet. TOPUP rows start
// PENDING and settle to PAID/FAILED through the payment-gateway callback
// (mirroring Subscription). SPEND rows (paying a subscription from balance)
// and REFUND rows are written already-settled. Shop.walletBalance is the
// running total; balanceAfter snapshots it per row for the ledger view.
model WalletTransaction {
  id              String   @id @default(cuid())
  shopId          String
  shop            Shop     @relation(fields: [shopId], references: [id])
  type            String   // "TOPUP" | "SPEND" | "REFUND"
  amount          Int      // toman, always positive; `type` gives the direction
  status          String   @default("PENDING") // "PENDING" | "PAID" | "FAILED"
  note            String?  // e.g. "شارژ کیف پول" or "اشتراک حرفه‌ای ۳ ماهه"
  paymentProvider String?  // gateway used for a TOPUP
  authority       String?  // gateway token for a TOPUP
  refId           String?  // gateway reference once verified
  balanceAfter    Int?     // wallet balance after this row settled
  createdAt       DateTime @default(now())

  @@index([shopId, createdAt])
}

// ── Cash book (دخل و خرج) ────────────────────────────────────
// The income side of a shop's finances already comes from Invoice totals;
// this is the missing EXPENSE side (rent, utilities, cash parts buys,
// wages, misc), so the owner can see true net profit — not just revenue.
model Expense {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id])
  amount        Int      // toman
  category      String   // RENT | WAGE | PARTS | UTILITY | OTHER
  note          String?
  createdByName String   // display only — who logged it
  spentAt       DateTime @default(now()) // when the money was actually spent (owner may backdate)
  createdAt     DateTime @default(now())

  @@index([shopId, spentAt])
}

// You — the SaaS owner — sign in separately from every shop's staff.
// Deliberately not tied to a Shop, so it isn't caught by any tenant-scoped
// query, and can't be created through the public signup flow.
model PlatformAdmin {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  passwordHash String
  role         String   @default("MANAGER") // OWNER | MANAGER
  permissions  String   @default("") // comma-separated platform capabilities
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

enum SubscriptionStatus {
  PENDING
  PAID
  FAILED
}

// One row per checkout attempt against Zarinpal. Successful payment
// extends Shop.planExpiresAt by 30 days and sets Shop.plan.
model Subscription {
  id        String             @id @default(cuid())
  shopId    String
  shop      Shop               @relation(fields: [shopId], references: [id])
  plan      String             // "pro" | "business"
  months    Int                @default(1) // duration purchased: 1, 3, 6, or 12
  amount    Int                // toman, already discounted for the duration
  paymentProvider String?      // "zarinpal" | "zibal" | "nextpay" — which gateway this attempt used
  authority String?            // gateway transaction token (Zarinpal authority / Zibal trackId / NextPay trans_id)
  refId     String?            // gateway reference id once verified/paid
  status    SubscriptionStatus @default(PENDING)
  createdAt DateTime           @default(now())

  @@index([shopId])
}

// A gift/discount code the platform admin generates and hands to a shop.
// Redeeming it grants a free paid subscription for `months` (no payment).
// Single-use: once redeemed it records which shop and when.
model GiftCode {
  id               String    @id @default(cuid())
  code             String    @unique // shown to the shop, e.g. "PEYVO-9F3K2"
  plan             String    // "pro" | "business"
  months           Int       @default(1) // free duration granted on redemption
  note             String?   // admin's own note: campaign, recipient, reason
  redeemedByShopId String?   // set when a shop redeems it
  redeemedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([redeemedByShopId])
}

// ── Users (shop staff) ──────────────────────────────────────

enum Role {
  OWNER     // full access: billing, staff management, all reports
  FRONTDESK // intake, customer-facing, invoicing
  HARDWARE
  SOFTWARE
  BOARD     // board-level / motherboard & data-recovery specialists
}

model User {
  id           String   @id @default(cuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id])
  name         String
  phone        String   @unique
  passwordHash String
  role         Role
  // Which repair lane this person actually works in, INDEPENDENT of role.
  // Lets an OWNER (or FRONTDESK) also be a technician — e.g. a solo owner
  // who is the shop's only hardware+software tech. null = coordinator only,
  // does not personally pick up lane work. One of HARDWARE/SOFTWARE/BOARD.
  specialty    String?
  active       Boolean  @default(true)
  avatarUrl    String?
  email        String?
  gmailId      String?
  nationalId   String?
  birthDate    DateTime?
  notifyEmail    Boolean @default(false)
  createdAt    DateTime @default(now())

  assignedTickets Ticket[]        @relation("AssignedTech")
  historyEntries  TicketHistory[]
  marketListings  MarketListing[]
  marketReplies   MarketReply[]
  deviceFlags        DeviceFlag[]
  deviceTransactions DeviceTransaction[]
  passwordResetTokens PasswordResetToken[]
  impersonationTokens ImpersonationToken[]
  conversationsStarted Conversation[] @relation("ConversationStarter")
  messages             Message[]
  supportTickets       SupportTicket[]
  ratingsReceived      Rating[]
  notifications        Notification[]
  partRequests          PartRequest[]

  @@index([shopId])
}

// ── Customers ────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  name      String
  phone     String
  // Optional extra info the shop can keep on a customer.
  email     String?
  address   String?
  note      String?  // free-form notes (preferences, history, anything)
  createdAt DateTime @default(now())

  tickets   Ticket[]

  @@index([shopId, phone])
}

// ── Repair workflow ─────────────────────────────────────────

// Which specialty lane a ticket currently sits in.
enum Lane {
  HARDWARE
  SOFTWARE
  BOARD
  READY     // repaired, awaiting pickup
}

enum TicketStatus {
  PENDING    // received by this lane, not started
  IN_PROGRESS
  AWAITING_APPROVAL // technician reported cost/parts, waiting on manager + customer sign-off
  REFERRED   // handed off to another lane
  READY
  DELIVERED
  CANCELLED
}

// How the customer acknowledged handing over the device at intake.
enum ReceiptAck {
  SHOP_PRINTED_SIGNED // shop already has its own pre-printed paper slip, customer signed that
  SITE_PRINTED_SIGNED // a receipt was printed from this system and the customer signed it
  NO_SIGNATURE         // device accepted with no signature/slip required
}

model Ticket {
  id            String       @id @default(cuid())
  shopId        String
  shop          Shop         @relation(fields: [shopId], references: [id])
  no            Int          // human-friendly sequential ticket number, scoped per shop
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id])

  deviceModel   String
  imei          String?
  issueInitial  String       // the problem as described at intake
  devicePasscode String?     // customer's screen lock/passcode, only if they opted to give it (for post-repair testing)
  devicePasscodeType String? // "PIN" | "PASSWORD" | "PATTERN" — how to interpret devicePasscode
  customerDamageNotes String? // pre-existing damage/prior repairs the customer discloses at intake
  receiptAck    ReceiptAck?  // how intake was acknowledged: shop's own printed slip, site-generated printed slip, or none
  intakeSource  String       @default("CUSTOMER") // CUSTOMER | PARTNER
  partnerName   String?      // direct intake from a colleague, even if they are not registered on Peyvo
  partnerPhone  String?

  lane          Lane
  status        TicketStatus @default(PENDING)
  assignedToId  String?
  assignedTo    User?        @relation("AssignedTech", fields: [assignedToId], references: [id])

  estimatedCost Int?         // toman
  finalCost     Int?
  technicianReportedCost Int? // cost the assigned technician proposes, awaiting manager approval
  technicianWage         Int? // manager-set wage paid to the technician for this repair
  technicianNote         String? // technician's note explaining the proposed cost/parts

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deliveredAt   DateTime?

  history       TicketHistory[]
  invoice       Invoice?
  partsUsed     TicketPart[]
  messages      TicketMessage[]

  @@unique([shopId, no])
  @@index([shopId, lane, status])
}

// Two-way chat between the customer and the shop, scoped to a single repair
// ticket. The customer reaches it from "تعمیرهای من"; the shop from the
// ticket detail. `fromCustomer` marks the author side; `senderUserId` holds
// the shop staff user id when the shop replies (null for customer messages).
model TicketMessage {
  id           String   @id @default(cuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id])
  fromCustomer Boolean  // true = customer wrote it, false = shop staff wrote it
  senderUserId String?  // shop user id when fromCustomer = false
  content      String
  createdAt    DateTime @default(now())
  readByShop     Boolean @default(false)
  readByCustomer Boolean @default(false)

  @@index([ticketId])
}

// Every transition (intake, start, referral, completion) is logged here —
// this IS the "stamped repair tag" timeline shown in the UI.
model TicketHistory {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  action    String   // e.g. "پذیرش دستگاه", "ارجاع به نرم‌افزار", "آماده تحویل"
  lane      Lane
  techId    String?
  tech      User?    @relation(fields: [techId], references: [id])
  note      String?
  createdAt DateTime @default(now())

  @@index([ticketId])
}

// ── Inventory ────────────────────────────────────────────────

model InventoryItem {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id])
  name        String   // e.g. "LCD سامسونگ A54"
  sku         String?
  // What kind of stock this is — lets a shop keep EVERYTHING phone-related
  // in one place, not just repair parts:
  // "PART" (قطعه) | "ACCESSORY" (لوازم جانبی) | "PHONE" (گوشی/دستگاه) |
  // "TOOL" (ابزار تعمیر) | "OTHER" (سایر)
  category    String   @default("PART")
  deviceModel String?  // which device(s) it fits, e.g. "Samsung A54" — also used by the market↔inventory matcher
  description String?  // free notes: grade, color, supplier, surplus info...
  imageUrl    String?  // product photo (uploaded via /api/upload)
  quantity    Int      @default(0)
  lowStockAt  Int      @default(2)
  costPrice   Int      // toman, what the shop paid
  sellPrice   Int      // toman, what the shop charges
  condition   String   @default("WORKING") // "WORKING" | "DEFECTIVE" — defective stock kept for parts/reference, not sold
  frequentlyUsed Boolean @default(false) // starred by the shop for quick pick in invoices

  usedIn      TicketPart[]
  soldIn      InvoiceItem[]

  @@index([shopId])
}

// Join table: which parts were consumed on which ticket (drives
// both inventory deduction and per-technician profit reporting).
model TicketPart {
  id          String        @id @default(cuid())
  ticketId    String
  ticket      Ticket        @relation(fields: [ticketId], references: [id])
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id])
  quantity    Int           @default(1)
  priceCharged Int          // toman, locked in at time of use
}

// ── Invoicing ────────────────────────────────────────────────

model Invoice {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id])
  // "REPAIR" invoices close out a Ticket; "SALE" invoices are direct
  // over-the-counter sales from inventory (accessories, phones, parts)
  // with no repair ticket at all — ticketId is null for those.
  type       String   @default("REPAIR")
  ticketId   String?  @unique
  ticket     Ticket?  @relation(fields: [ticketId], references: [id])
  // Walk-in customer info for SALE invoices (optional — cash sales can be anonymous)
  customerName  String?
  customerPhone String?
  laborCost  Int      // toman
  partsCost  Int      // toman, sum of TicketPart/InvoiceItem priceCharged
  technicianWage Int  @default(0) // paid out to the assigned technician
  taxPercent Float    @default(0) // percent applied at invoice time (locked in, in case shop changes rate later)
  taxAmount  Int      @default(0) // toman, computed at invoice time
  total      Int
  paid       Boolean  @default(false)
  paidAmount Int      @default(0) // supports partial cash/card settlement
  paymentPendingAmount Int?       // exact remaining amount sent to the online gateway
  lastPaymentAt DateTime?
  // Online payment by the customer (/pay/[invoiceId]) via the active gateway
  paymentProvider  String? // "zarinpal" | "zibal" | "nextpay"
  paymentAuthority String? // gateway transaction token
  paymentRefId     String?
  createdAt  DateTime @default(now())

  items      InvoiceItem[]

  @@index([shopId])
}

// Line items for direct-SALE invoices (the counterpart of TicketPart,
// which stays reserved for repair-ticket part consumption).
model InvoiceItem {
  id           String        @id @default(cuid())
  invoiceId    String
  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  itemId       String
  item         InventoryItem @relation(fields: [itemId], references: [id])
  quantity     Int           @default(1)
  priceCharged Int           // toman total for this line, locked in at sale time

  @@index([invoiceId])
}

// One-time SMS code for the forgot-password flow. Short-lived (10 min)
// and single-use; never store the plain reset link, only this code.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  code      String   // 5-digit numeric OTP sent via SMS
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// One-time code that verifies a phone (or email) BEFORE a shop/customer
// account is created at signup. Keyed by the phone itself (no account exists
// yet). Short-lived; consumed when the account is finally created.
model SignupVerification {
  id         String   @id @default(cuid())
  identifier String   // the phone number being verified (login key)
  code       String   // 5-digit numeric OTP
  verified   Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([identifier])
}

// Distributed request throttling shared by all Vercel instances.
model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// ── Nationwide marketplace ───────────────────────────────────
// Unlike every other model above, these are NOT shop-isolated on read —
// any signed-in technician from any shop can see listings from any other
// shop (that's the whole point: connecting technicians nationwide). Writes
// are still tagged with shopId/authorId so we know who posted what and can
// let them manage/close their own posts.

enum ListingCategory {
  BOARD       // شماتیک / نقشه برد
  FLASH_FILE  // فایل فلش رسمی/تست‌شده
  PART        // قطعه فیزیکی (IC، LCD، باتری و...)
  EXPERTISE   // مشاوره یا کمک تخصصی
  OTHER
}

enum ListingStatus {
  OPEN
  RESOLVED
}

enum ListingType {
  REQUEST // "دنبال این می‌گردم"
  OFFER   // "این را دارم / برای فروش دارم"
}

model MarketListing {
  id           String          @id @default(cuid())
  shopId       String
  shop         Shop            @relation(fields: [shopId], references: [id])
  authorId     String
  author       User            @relation(fields: [authorId], references: [id])
  listingType  ListingType     @default(REQUEST)

  category     ListingCategory
  title        String
  description  String
  deviceModel  String?         // e.g. "Samsung A54" — makes search precise
  imageUrl     String?         // photo of the part/product (uploaded via /api/upload)

  province     String
  city         String

  status       ListingStatus   @default(OPEN)
  showContact  Boolean         @default(true) // author can hide phone/address on this post
  createdAt    DateTime        @default(now())

  replies       MarketReply[]
  conversations Conversation[]

  @@index([province, city])
  @@index([category, status])
}

// Direct 1-to-1 chat thread on a listing, like Divar's "چت" button —
// separate from the public MarketReply comments above. One conversation
// per (listing, interested user) pair; the listing author is always the
// other participant.
model Conversation {
  id            String        @id @default(cuid())
  listingId     String
  listing       MarketListing @relation(fields: [listingId], references: [id])
  starterId     String        // the interested user who opened the chat
  starter       User          @relation("ConversationStarter", fields: [starterId], references: [id])
  createdAt     DateTime      @default(now())

  messages      Message[]

  @@unique([listingId, starterId])
  @@index([listingId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String       // may be empty when the message is image-only
  imageUrl       String?      // attached photo (uploaded via /api/upload)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model MarketReply {
  id          String        @id @default(cuid())
  listingId   String
  listing     MarketListing @relation(fields: [listingId], references: [id])
  shopId      String
  shop        Shop          @relation(fields: [shopId], references: [id])
  authorId    String
  author      User          @relation(fields: [authorId], references: [id])
  message     String
  createdAt   DateTime      @default(now())

  @@index([listingId])
}

// ── Nationwide device history ("medical record" by IMEI) ────
// Like the marketplace above, these are intentionally NOT shop-isolated
// on read: the whole point is that any shop, anywhere in Iran, searching
// an IMEI sees the device's full repair + ownership history — even
// history recorded by a different shop. Ticket.imei already gives free
// repair-history lookup (see /api/devices/[imei]); these two models add
// the crowd-sourced flag and the resale/ownership chain on top of that.

enum FlagType {
  STOLEN
  INSTALLMENT_DEBT // قسط پرداخت‌نشده / در گرو بانک یا فروشگاه
  OTHER
}

// Crowd-sourced warning, NOT an official/legal registry check — this is
// reported by fellow technicians/dealers, not verified against police or
// carrier records. The UI must always display it with that caveat.
model DeviceFlag {
  id          String   @id @default(cuid())
  imei        String
  flagType    FlagType
  note        String
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id])
  reporterId  String
  reporter    User     @relation(fields: [reporterId], references: [id])
  createdAt   DateTime @default(now())

  @@index([imei])
}

// One row per sale logged by a dealer — builds the ownership chain
// ("previously owned by X, sold to Y, by which dealer, on what date").
model DeviceTransaction {
  id          String   @id @default(cuid())
  imei        String
  deviceModel String
  sellerName  String
  sellerPhone String?
  buyerName   String
  buyerPhone  String?
  price       Int?     // toman, optional
  note        String?
  shopId      String   // the dealer who logged this transaction
  shop        Shop     @relation(fields: [shopId], references: [id])
  loggedById  String
  loggedBy    User     @relation(fields: [loggedById], references: [id])
  createdAt   DateTime @default(now())

  @@index([imei])
}


// ── Device catalog customization ────────────────────────────
// The brand/model list itself is a static catalog in lib/device-catalog.ts
// (shared by all shops, like a phone book). These two tables let each shop
// personalize it: star brands they see most for quick access, and add
// models/brands that aren't in the static list without editing code.

model FavoriteBrand {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])
  brand  String

  @@unique([shopId, brand])
}

model CustomDeviceModel {
  id      String @id @default(cuid())
  shopId  String
  shop    Shop   @relation(fields: [shopId], references: [id])
  brand   String
  model   String
  createdAt DateTime @default(now())

  @@index([shopId])
}

// ── Editable issue templates ─────────────────────────────────
// Quick-pick chips shown on the intake form per specialty lane, seeded
// with sensible defaults but fully editable per shop (add/rename/remove).
model IssueTemplate {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])
  lane   Lane   // which specialty tab this chip shows under
  label  String

  @@index([shopId, lane])
}

// ── Platform support ─────────────────────────────────────────
enum SupportStatus {
  OPEN
  CLOSED
}

model SupportTicket {
  id        String        @id @default(cuid())
  shopId    String
  shop      Shop          @relation(fields: [shopId], references: [id])
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  subject   String
  message   String
  status    SupportStatus @default(OPEN)
  createdAt DateTime      @default(now())

  replies   SupportReply[]
}

model SupportReply {
  id              String        @id @default(cuid())
  supportTicketId String
  supportTicket   SupportTicket @relation(fields: [supportTicketId], references: [id])
  fromPlatform    Boolean       // true = platform admin replied, false = shop replied
  message         String
  createdAt       DateTime      @default(now())

  @@index([supportTicketId])
}

// ── Returns / refunds ────────────────────────────────────────
model ReturnRecord {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id])
  ticketId      String?
  deviceModel   String
  customerName  String
  customerPhone String?
  reason        String
  refundAmount  Int?
  resolved      Boolean  @default(false)
  resolutionNote String?
  createdAt     DateTime @default(now())

  @@index([shopId])
}

// ── Platform-wide settings (super admin editable) ────────────
// Singleton row (id always "singleton") so API keys can be rotated from
// the super-admin dashboard instead of redeploying with new env vars.
// lib/sms.ts and lib/zarinpal.ts read this first and fall back to env
// vars if no row exists yet.
model PlatformSettings {
  id                  String  @id @default("singleton")
  kavenegarApiKey     String?
  kavenegarSender     String?
  // Kavenegar OTP/Lookup (سرویس اعتبارسنجی) — when smsUseLookup is on, the
  // three core transactional messages (verification codes, intake, ready) are
  // sent via approved templates instead of free-form text, so no dedicated
  // line is needed. The *Template fields hold the exact approved template
  // names created in the Kavenegar panel. Off by default: until the templates
  // exist, sends fall back to free-form so nothing breaks.
  // Automatic backups to a Telegram bot. When both are set, the daily cron
  // (/api/cron/backup) sends a full JSON snapshot to this chat via the Bot API.
  telegramBotToken        String? // from @BotFather
  telegramChatId          String? // the chat/channel id the backup file is sent to
  telegramBackupEnabled   Boolean? @default(false)
  telegramBackupHour      Int?     @default(3) // Iran local hour (0..23)
  // Android app distribution links, shown on the public /download page and the
  // landing footer. Set once the APK is built and the store listings are live.
  androidApkUrl           String? // direct .apk download link (site download)
  bazaarUrl               String? // Cafe Bazaar (کافه‌بازار) store page
  myketUrl                String? // Myket (مایکت) store page
  // Cafe Bazaar services. Stored server-side; never expose through public APIs.
  // The RSA public key is used only when Bazaar in-app billing is implemented.
  bazaarRsaPublicKey      String?
  bazaarDynamicDiscountKey String?
  // Myket in-app billing. The RSA public key is delivered to the native app;
  // the access token is server-only and is used solely for server-to-server
  // purchase verification with Myket.
  myketRsaPublicKey       String?
  myketAccessToken        String?
  smsUseLookup            Boolean @default(false)
  kavenegarOtpTemplate    String? // template for verification/reset codes  (%token = code)
  kavenegarIntakeTemplate String? // device-received template  (%token=ticket, %token2=phone, %token10=shop)
  kavenegarReadyTemplate  String? // ready-for-pickup template  (%token=ticket, %token2=price, %token3=phone, %token10=shop)
  zarinpalMerchantId  String?
  // Which gateway is currently active platform-wide: "zarinpal" | "zibal" | "nextpay".
  paymentProvider     String? @default("zarinpal")
  zibalMerchant       String? // Zibal merchant id (or "zibal" for their sandbox)
  nextpayApiKey       String? // NextPay api_key
  guideUrl            String? // link to an external help/docs site
  aboutUsContent      String? // shown on the built-in /about page
  smtpHost            String?
  smtpPort            Int?
  smtpUser            String?
  smtpPassword        String?
  smtpFromAddress     String?
  neshanApiKey        String? // for the interactive location-picker map (react-neshan-map-leaflet)
  // Enamad (نماد اعتماد الکترونیکی) trust-seal identifiers — public values
  // shown in the seal markup on public pages. Required by payment gateways
  // before granting a live درگاه.
  enamadId            String?
  enamadCode          String?
  // Site-wide appearance, changed live from the super-admin panel (no
  // redeploy). fontFamily is a key into lib/fonts.ts FONT_OPTIONS; the
  // root layout loads the matching Google-Fonts stylesheet and sets the
  // --app-font CSS variable. defaultTheme is the initial theme a brand-new
  // visitor sees ("dark" | "light") before any personal choice is stored.
  fontFamily          String? @default("vazirmatn")
  defaultTheme        String? @default("dark")
  // Subscription pricing overrides (toman / percent), editable from the
  // super-admin panel so plans can be repriced without a code change. null on
  // any field = fall back to the code default in lib/plans.ts. Read through
  // getPricing(), which every price calculation (checkout, gift-quota, the
  // shop-facing billing page via /api/pricing) goes through.
  proPriceToman       Int?     // monthly price of the "pro" (حرفه‌ای) plan
  businessPriceToman  Int?     // monthly price of the "business" (تجاری) plan
  proQuota            Int?     // monthly device-intake quota granted by "pro"
  businessQuota       Int?     // monthly device-intake quota granted by "business"
  discount3           Int?     // % discount for the 3-month commitment
  discount6           Int?     // % discount for the 6-month commitment
  discount12          Int?     // % discount for the 12-month commitment
  // ── AI provider configuration (Super Admin editable) ──
  // Runtime config for the provider-agnostic AI layer (lib/ai). Read through
  // lib/ai/config.ts with env vars as a dev fallback. API keys are stored
  // ENCRYPTED via lib/crypto (aiApiKey/aiFallbackApiKey are in
  // PLATFORM_SECRET_FIELDS) and are never returned to the browser.
  aiEnabled           Boolean? // master on/off (null/false = off)
  aiProvider          String?  // "disabled" | "mock" | "openai-compat"
  aiBaseUrl           String?  // primary endpoint (for openai-compat)
  aiApiKey            String?  // ENCRYPTED primary credential
  aiModel             String?  // primary model id
  aiFallbackProvider  String?  // optional fallback provider key
  aiFallbackBaseUrl   String?  // fallback endpoint
  aiFallbackApiKey    String?  // ENCRYPTED fallback credential
  aiFallbackModel     String?  // fallback model id
  aiTimeoutMs         Int?     // per-call timeout
  aiMaxRetries        Int?     // transient-error retries
  aiShopDailyLimit    Int?     // per-shop daily call cap (0 = unlimited)
  updatedAt           DateTime @updatedAt
}

// ── Normalized purchase record (store-agnostic subscriptions) ──
// One row per verified purchase/renewal from ANY payment source (web gateway,
// Cafe Bazaar, Myket, future stores). `externalRef` is the global idempotency
// key (unique), so the same purchase can never activate entitlement twice.
// SubscriptionService is the only writer. No foreign key (mirrors the audit
// tables): shopId is best-effort and entitlement itself lives on Shop.
model PurchaseRecord {
  id           String   @id @default(cuid())
  shopId       String
  source       String   // "web" | "mock" | "bazaar" | "myket" | ...
  externalRef  String   @unique // idempotency key across all sources
  plan         String   // "pro" | "business"
  months       Int
  amountToman  Int?
  status       String   @default("ACTIVE") // ACTIVE | CANCELLED | REFUNDED | EXPIRED
  autoRenewing Boolean  @default(false)
  purchasedAt  DateTime @default(now())
  expiresAt    DateTime? // entitlement expiry snapshot at activation time
  raw          String?   // opaque provider payload (audit)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([shopId, createdAt])
  @@index([source, status])
}

// ── AI configuration change audit (Phase — AI provider management) ──
// One row each time the Super Admin changes AI configuration. Stores only the
// changed field NAMES (never API keys / values). No foreign key (mirrors
// ErrorLog/PasscodeAccessLog) so an audit write can never fail/cascade.
model AiConfigAudit {
  id            String   @id @default(cuid())
  adminId       String
  changedFields String // comma-separated field names — NEVER values
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

// ── In-app notifications ──────────────────────────────────────
// Personal notifications (e.g. "someone needs a part you have listed",
// "manager approved your price") plus platform-wide broadcasts from the
// super admin (one row per recipient, isBroadcast just marks the origin).
model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  message     String
  link        String?  // optional in-app path to open on click
  isBroadcast Boolean  @default(false)
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, read])
}

// ── Ad space (super admin managed) ────────────────────────────
model AdBanner {
  id          String   @id @default(cuid())
  imageUrl    String
  linkUrl     String?
  displayType String   @default("BANNER") // "BANNER" (inline strip) | "POPUP" (closable overlay, once per session)
  title       String?
  description String?
  ctaLabel    String?
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

// ── Part purchase requests (technician → manager) ─────────────
// When a technician needs a part they don't have, they can either log
// it directly in inventory themselves, or raise a request the manager
// fulfills (purchases and adds to inventory).
enum PartRequestStatus {
  PENDING
  FULFILLED
  REJECTED
}

model PartRequest {
  id           String            @id @default(cuid())
  shopId       String
  shop         Shop              @relation(fields: [shopId], references: [id])
  requestedById String
  requestedBy   User             @relation(fields: [requestedById], references: [id])
  ticketId     String?
  itemName     String
  note         String?
  status       PartRequestStatus @default(PENDING)
  createdAt    DateTime          @default(now())

  @@index([shopId, status])
}

// ── Reference repair pricing guide ────────────────────────────
// NOT a live feed from Iran's mobile guild (اصناف موبایل ایران) — no
// public API exists for that. This is a manually-maintained reference
// table shops can fill in themselves (or copy from official guild
// bulletins) so technicians see a suggested fair price while working an
// issue, encouraging more consistent pricing nationwide.
model ReferencePrice {
  id          String @id @default(cuid())
  shopId      String
  shop        Shop   @relation(fields: [shopId], references: [id])
  deviceModel String
  issueLabel  String // matches an IssueTemplate label where possible
  suggestedPrice Int // toman
  source      String? // e.g. "بخشنامه اصناف تیر ۱۴۰۵" — free text citation
  updatedAt   DateTime @updatedAt

  @@index([shopId])
}

// ── QR self-intake ────────────────────────────────────────────
// A customer scans the shop's QR code, fills in their own device info on
// a public (no-login) page, and it lands here for the manager to review.
// Approving converts it into a real Ticket; rejecting just discards it.
enum PendingIntakeStatus {
  PENDING
  APPROVED
  REJECTED
}

model PendingIntake {
  id            String              @id @default(cuid())
  shopId        String
  shop          Shop                @relation(fields: [shopId], references: [id])
  customerName  String
  customerPhone String
  deviceModel   String
  imei          String?
  issueDescription String
  devicePasscode String?
  devicePasscodeType String? // "PIN" | "PASSWORD" | "PATTERN"
  status        PendingIntakeStatus @default(PENDING)
  createdAt     DateTime            @default(now())

  @@index([shopId, status])
}

// ── Customer ratings & rankings ──────────────────────────────
// Public, no-login rating submitted by a customer after a repair (e.g. via
// a link in the delivery SMS). Feeds the province/national "top repair
// shops" ranking pages.
model Rating {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id])
  ticketId      String?  @unique
  technicianId  String?
  technician    User?    @relation(fields: [technicianId], references: [id])
  // Set when the rating was submitted from the customer dashboard by a
  // signed-in PlatformCustomer (as opposed to the anonymous post-repair
  // SMS link, which leaves this null). One direct rating per
  // (customer, shop) pair is enforced in the API.
  platformCustomerId String?
  platformCustomer   PlatformCustomer? @relation(fields: [platformCustomerId], references: [id])
  stars         Int      // 1-5
  comment       String?
  customerPhone String?  // used only to prevent duplicate ratings per ticket, never shown publicly
  createdAt     DateTime @default(now())

  @@index([shopId])
  @@index([technicianId])
  @@index([platformCustomerId])
}

// ── Platform-wide customer accounts ──────────────────────────
// A NATIONWIDE customer identity, completely separate from the per-shop
// `Customer` model above (which is just each shop's private address book).
// A PlatformCustomer signs in through their own login (/customer/login),
// browses/compares shops, sees their own repair history across ALL shops
// (matched by phone number), and can rate shops directly from their panel.
// Deliberately NOT tied to any Shop, so it is never caught by tenant
// scoping and can never be created through the shop signup flow.
model PlatformCustomer {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  passwordHash String
  email        String?  // optional — enables password recovery via email too
  province     String?  // used as the default filter for "shops near me"
  city         String?
  active       Boolean  @default(true) // platform admin can suspend a customer account
  createdAt    DateTime @default(now())

  ratings          Rating[]
  passwordResetTokens CustomerPasswordResetToken[]
}

// Same 10-minute single-use OTP pattern as PasswordResetToken, but for
// PlatformCustomer accounts (separate table so the two login systems
// stay fully independent).
model CustomerPasswordResetToken {
  id         String           @id @default(cuid())
  customerId String
  customer   PlatformCustomer @relation(fields: [customerId], references: [id])
  code       String           // 5-digit numeric OTP sent via SMS
  expiresAt  DateTime
  used       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([customerId])
}

// ── External government/agency API access ────────────────────
// We don't have a real spec from Asnaf/Tazirat/tax authorities — this is
// simply OUR read-only export endpoint, key-protected, that any of those
// agencies (or a future integration) can be given credentials for.
model ExternalApiKey {
  id        String   @id @default(cuid())
  label     String   // e.g. "اتحادیه اصناف موبایل ایران", "اداره تعزیرات"
  apiKey    String   @unique
  // Comma-separated list of data categories this key may read, chosen by
  // the platform admin when creating/editing the key — no code change
  // needed to grant/revoke access to a category later. Current categories:
  // "device_flags", "device_transactions", "shop_directory",
  // "shop_verification", "ratings"
  scopes    String   @default("device_flags,device_transactions")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ── Dealer inventory (phone buy/sell) ─────────────────────────
// A shop with type "DEALER" or "BOTH" uses this to track phones it
// currently holds in stock and phones it has sold. Selling a phone here
// also creates a public DeviceTransaction record (same table used by
// /device-lookup) so the ownership chain stays consistent everywhere.
enum DealerStockStatus {
  IN_STOCK
  SOLD
}

model DealerInventory {
  id            String            @id @default(cuid())
  shopId        String
  shop          Shop              @relation(fields: [shopId], references: [id])
  imei          String?
  deviceModel   String
  imageUrl      String?           // product photo (uploaded via /api/upload)
  condition     String            @default("WORKING") // "WORKING" | "DEFECTIVE" | "FOR_PARTS"
  purchasePrice Int               // toman, what the dealer paid
  askingPrice   Int?              // toman, listed sale price while in stock
  sourceName    String?           // who the dealer bought it from
  sourcePhone   String?
  status        DealerStockStatus @default(IN_STOCK)
  soldPrice     Int?
  buyerName     String?
  buyerPhone    String?
  notes         String?
  acquiredAt    DateTime          @default(now())
  soldAt        DateTime?

  @@index([shopId, status])
}

// ── Cross-shop collaboration (partnerships, referrals, commission) ──
// Deliberately separate from Ticket.lane (which only moves a ticket
// between HARDWARE/SOFTWARE/BOARD lanes WITHIN one shop). This is for
// technicians at DIFFERENT, physically separate shops who want to send
// each other work — e.g. a hardware-only shop referring a software-only
// job to a partner shop across town, and getting a commission back for it.

enum PartnershipStatus {
  PENDING   // request sent, other shop hasn't responded yet
  ACCEPTED  // both shops can now refer customers to each other
  REJECTED
  ENDED     // either shop cut off an active partnership later
}

// A standing collaboration link between two shops. Any staff member at
// either shop (not just the OWNER) can send/accept these — this is meant
// to be usable directly by the technicians who'll actually refer work,
// not gated behind manager approval.
model ShopPartnership {
  id                String            @id @default(cuid())
  requestedByShopId String
  requestedByShop   Shop              @relation("PartnershipSentBy", fields: [requestedByShopId], references: [id])
  targetShopId      String
  targetShop        Shop              @relation("PartnershipSentTo", fields: [targetShopId], references: [id])
  status            PartnershipStatus @default(PENDING)
  note              String?           // optional message sent along with the request
  createdByName     String            // display only — which staff member sent it
  createdAt         DateTime          @default(now())
  respondedAt       DateTime?

  referrals         ShopReferral[]

  @@unique([requestedByShopId, targetShopId])
  @@index([targetShopId, status])
  @@index([requestedByShopId, status])
}

enum ReferralStatus {
  SENT      // referring shop created it, receiving shop hasn't acted yet
  ACCEPTED  // receiving shop took the customer in and opened their own ticket
  DECLINED
  COMPLETED // receiving shop finished the job — commission now applies
}

enum CommissionStatus {
  NONE    // no commission expected for this referral
  PENDING // amount recorded, not yet settled
  PAID
}

// A cross-shop hand-off of a customer/device. The receiving shop is NOT
// given access to the referring shop's ticket/customer records (tenant
// isolation stays intact) — instead this carries plain copied-over
// details, and accepting it creates a brand-new Ticket + Customer inside
// the receiving shop exactly like a normal intake would.
model ShopReferral {
  id             String            @id @default(cuid())
  partnershipId  String
  partnership    ShopPartnership   @relation(fields: [partnershipId], references: [id])
  fromShopId     String
  fromShop       Shop              @relation("ReferralFrom", fields: [fromShopId], references: [id])
  toShopId       String
  toShop         Shop              @relation("ReferralTo", fields: [toShopId], references: [id])

  customerName   String
  customerPhone  String
  deviceModel    String?
  issueNote      String?
  suggestedLane  String?           // "HARDWARE" | "SOFTWARE" | "BOARD" — hint only, receiving shop can re-refer internally afterward
  handoffMethod  String?           // CUSTOMER | COURIER | OWNER | APPRENTICE | OTHER
  carrierName    String?           // person physically carrying the device, when known
  carrierPhone   String?
  handoffNote    String?           // courier details, timing, tracking code, etc.

  status         ReferralStatus    @default(SENT)
  resultTicketId String?           // the Ticket the receiving shop opened upon accepting

  commissionType    String?           // "PERCENT" | "FLAT" — arrangement suggested when the referral was sent
  commissionValue   Int?              // percent (0-100) or flat toman, per commissionType — a suggestion only
  commissionAmount  Int?              // toman, final figure entered by the receiving shop when marked COMPLETED
  commissionStatus  CommissionStatus  @default(NONE)
  commissionPaidAt  DateTime?

  createdByName  String            // display only — which staff member at fromShop created this
  createdAt      DateTime          @default(now())
  respondedAt    DateTime?
  completedAt    DateTime?

  @@index([fromShopId, status])
  @@index([toShopId, status])
}

// ── Platform support impersonation ────────────────────────────
// A short-lived, single-use token that lets platform support sign in AS a
// shop's owner for troubleshooting — only ever issued when the shop has
// opted in via Shop.supportAccessEnabled, and every use is logged for
// audit purposes (createdByAdminId).
model ImpersonationToken {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  token           String    @unique
  createdByAdminId String
  used            Boolean   @default(false)
  expiresAt       DateTime
  createdAt       DateTime  @default(now())

  @@index([userId])
}

// ── Error log (خطاها) ─────────────────────────────────────────
// A lightweight, self-hosted error database so the platform owner can
// see WHAT broke in production and WHERE, straight from the super-admin
// panel — no external Sentry account needed. Deliberately has NO foreign
// keys to Shop/User: a logging write must NEVER fail or cascade because
// of a missing/invalid id, so shopId/userId are plain best-effort strings.
// Written from three places: server API catch blocks (lib/logError.ts),
// the React error boundaries (app/error.tsx, app/global-error.tsx), and
// the browser window error listeners (components/ClientErrorReporter.tsx),
// the latter two via the public POST /api/log-error intake.
model ErrorLog {
  id         String   @id @default(cuid())
  source     String   @default("server") // "server" | "client" | "payment" | "boundary"
  level      String   @default("error")  // "error" | "warn" | "fatal"
  message    String                       // short human summary / error message
  stack      String?                      // full stack trace or extra detail (can be long)
  digest     String?                      // Next.js error-boundary digest, when present
  path       String?                      // URL path / route where it happened
  method     String?                      // HTTP method, for server errors
  shopId     String?                      // best-effort tenant tag (NOT a foreign key)
  userId     String?                      // best-effort actor tag (NOT a foreign key)
  userAgent  String?                      // browser UA, for client errors
  context    String?                      // small JSON blob of extra key/values
  resolved   Boolean  @default(false)     // super admin ticks these off once handled
  createdAt  DateTime @default(now())

  @@index([resolved, createdAt])
  @@index([source, createdAt])
}

// ── Passcode access audit (Phase 1 security) ──────────────────
// One row is written every time a staff member reveals a customer's device
// passcode via GET /api/tickets/:id/passcode. Like ErrorLog, this table
// deliberately has NO foreign keys to Shop/User/Ticket: an audit write must
// never fail or cascade because of a missing/invalid id, so shopId/ticketId/
// userId are plain best-effort strings.
model PasscodeAccessLog {
  id        String   @id @default(cuid())
  shopId    String
  ticketId  String
  userId    String
  createdAt DateTime @default(now())

  @@index([shopId, createdAt])
  @@index([ticketId])
}

// ── AI suggestion audit/history (Phase 3 — Intake Helper slice) ──
// One row per AI Repair Assistant request. Advisory only — this stores what
// was asked and the suggestion produced, for audit and later review; it never
// drives ticket state. `inputSummary` is REDACTED before storage. Like
// ErrorLog/PasscodeAccessLog, it deliberately has NO foreign keys so an audit
// write can never fail/cascade — shopId/ticketId/createdByUserId are strings.
model AiSuggestion {
  id              String   @id @default(cuid())
  shopId          String
  ticketId        String?
  createdByUserId String
  kind            String // e.g. "intake_helper"
  inputSummary    String? // redacted context that was sent
  output          String? // JSON of the produced suggestion (null unless status = ok)
  provider        String // provider that answered, or "none"
  model           String?
  status          String // "ok" | "empty" | "error" | "disabled" | "quota_exceeded"
  createdAt       DateTime @default(now())

  @@index([shopId, ticketId])
  @@index([shopId, createdAt])
}

// Server-side registry for JWT-backed logins. This deliberately has no
// foreign keys: login history remains useful if an account or shop is later
// deleted, and an audit write must not cascade into account data.
enum LoginSubjectKind {
  SHOP_USER
  CUSTOMER
  SUPERADMIN
}

model LoginSession {
  id               String           @id @default(cuid())
  subjectKind      LoginSubjectKind
  subjectId        String
  roleAtLogin      String?
  nameAtLogin      String
  phoneAtLogin     String
  shopId           String?
  shopNameAtLogin  String?
  provider         String
  ipAddress        String?
  userAgent        String?
  signedInAt       DateTime         @default(now())
  lastActivityAt   DateTime         @default(now())
  expiresAt        DateTime
  loggedOutAt      DateTime?
  revokedAt        DateTime?
  revokedByAdminId String?
  revokedReason    String?
  lastRevokedAt    DateTime?
  restoredAt       DateTime?
  restoredByAdminId String?
  restorationCount Int              @default(0)

  @@index([subjectKind, subjectId])
  @@index([shopId])
  @@index([signedInAt])
  @@index([lastActivityAt])
  @@index([revokedAt, loggedOutAt, expiresAt])
}
